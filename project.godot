;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FireEmblem2026"
config/description="A GBA Fire Emblem-inspired tactics game."
run/main_scene="res://gameplay/battle.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

WindowControls="*res://gameplay/window_controls.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

